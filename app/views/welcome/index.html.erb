<% organization_contacts = !@person.organization_contacts.empty? %>

<div class="card content">
	<%# <p><b>Welcome!</b> EXP-Online is a collection of web applications used by the Center for Experiential Learning and Diversity. You may have been redirected to this page from one of these applications. You might be able to find what you're looking for by clicking a link below. Otherwise, please return to the web address that you were originally given to continue your work.</p> %>
	 <div class="eyebrow">Center for Experiential Learning and Diversity</div>
	  <h4><b>Welcome to EXP-Online</b></h4>
	  <p class="intro">Find your applications, activities, and events in one place. Choose a tab below to see what’s available to you.</p>
	  <div class="notice_box">
	    <i class='mi uw_purple'>info</i>
	    <span>Arrived here from another application? If you don’t see what you need, return to the original link you were given.</span>
	 </div>	  
</div>

<div class="card content">
 <div class="row">
  <div class="col s12">
  	<ul class="tabs">
        <li class="tab col"><a class='active' href="#online_applications"><i class='mi md-18'>assignment</i> Online Applications (<%= @total_person_apps.size %>)</a></li>
        <% if organization_contacts %>
        	<li class="tab col"><a href="#community_partner"><i class='mi md-18'>assignment</i> Community Partner</a></li>
        <% end %>
        <li class="tab col"><a href="#events"><i class='mi md-18'>event</i> Events (<%= @person.event_invites.size %>)</a></li>
        <%# if @student %>
			 <!--li class="tab col"><a href="#community_engaged_student"><i class='mi md-18'>business</i> Current Community Engagement (<#%= @service_learning_courses.size %>)</a></li-->
        <%# end %>
        <% unless @student %>
        	<li class="tab col"><a href="#community_engaged_instructor"><i class='mi md-18'>menu_book</i>
        		<%# Community Engaged %>
        		Instructor (<%= @person.service_learning_courses.size %>)</a></li>
        <% end %>        
	</ul>
    <div id="online_applications" class="col s12">
		<!--<h5>My Online Applications</h5>-->
		<%= render "online_applications" %>
	</div>
	<% if organization_contacts %>
		<div id="community_partner" class="col s12">
			<%# <h5>Community Partner</h5> %>
			<%= render "community_partner" %>
		</div>
	<% end %>
	<div id="events" class="col s12">
		<%# <h5>Events</h5> %>
		<%= render "events" %>
	</div>
	<%# if @student %>
		<!--div id="community_engaged_student" class="col s12">
			<%# <h5>Current Community Engagement</h5> %>
			<%#= render "community_engaged_student" %>
		</div-->
	<%# end %>
	<% unless @student %>
		<div id="community_engaged_instructor" class="col s12">
			<%# <h5>Community Engaged Instructor</h5> %>
			<%= render "community_engaged_instructor" %>
		</div>
	<% end %>	
  </div>
 </div>
</div>
