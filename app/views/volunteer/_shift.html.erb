<% blur_if_signed_up ||= false %>
<% return_to ||= {} %>
<% person = @current_user.person %>
<% signed_up = shift.signed_up?(person) %>
<% klass = 'signed_up' if blur_if_signed_up && signed_up %>
<% ordered_shifts = position.shifts.sort %>

<td class="<%= klass %>"><%= shift.time_detail(date_only: true) %></td>
<td class="<%= klass %>" style="vertical-align: middle; height: 3.5rem;">
  <span style="position: relative; display: inline-block;">
    <%= shift.time_detail(time_only: true) %>
    <% unless shift.capacity.nil? %>
      <small class="gray" style="position: absolute; top: 100%; left: 0; white-space: nowrap; line-height: 1.2;">
        <% if shift.full? %>
          Full (<%= shift.capacity %> of <%= shift.capacity %> spots filled)
        <% else %>
          <span class="uw_green"><%= pluralize(shift.remaining_capacity, 'spot') %> available</span>
        <% end %>
      </small>
    <% end %>
  </span>
</td>

<% if position.require_all_shifts? %>
  <% if shift == ordered_shifts.first %>
    <%# The action cell spans every shift in this position. %>
    <% already_signed_up = ordered_shifts.any? { |s| s.signed_up?(person) } %>
    <% overlapping = ordered_shifts.any? do |s|
         !s.signed_up?(person) && s.overlapping_shifts.any? { |other| other.signed_up?(person) }
       end %>
    <td rowspan="<%= ordered_shifts.size %>" class="<%= klass %>">
      <% if already_signed_up %>
        <%= button_to 'Cancel my signup (all shifts)',
              volunteer_unsignup_path(@event, { position_id: position }.merge(return_to)),
              method: :delete, class: 'btn' %>
      <% elsif overlapping %>
        <p class="gray">Overlaps with other signed up shifts</p>
      <% elsif ordered_shifts.any?(&:full?) %>
        <span class="gray">Sign-up unavailable (one or more shifts are full)</span>
      <% else %>
        <%= button_to 'Sign up (all shifts)',
              volunteer_signup_path(@event, { position_id: position }.merge(return_to)),
              method: :put, class: 'btn' %>
      <% end %>
    </td>
  <% end %>
<% else %>
  <td class="<%= klass %>">
    <% if signed_up %>
      <%= button_to 'Cancel my signup',
            volunteer_unsignup_path(@event, { shift_id: shift }.merge(return_to)),
            method: :delete, class: 'btn' %>
    <% elsif shift.overlapping_shifts.any? { |other| other.signed_up?(person) } %>
      <p class="gray">Overlaps with other signed up shifts</p>
    <% elsif shift.full? %>
      <span class="gray">Shift full</span>
    <% else %>
      <%= button_to 'Sign up',
            volunteer_signup_path(@event, { shift_id: shift }.merge(return_to)),
            method: :put, class: 'btn' %>
    <% end %>
  </td>
<% end %>

<% unless shift == ordered_shifts.last %>
  </tr><tr>
<% end %>
